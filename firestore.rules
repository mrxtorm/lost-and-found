rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS
    // ============================================================

    // True while the signed-in user has an active temporary POSTING ban.
    // bannedUntil is written only by the moderation Worker.
    function isBanned() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath)
        && get(userPath).data.get('bannedUntil', null) != null
        && get(userPath).data.bannedUntil > request.time;
    }


    // ============================================================
    // ACCESS GATE (server-side enforcement)
    // Protected data requires BOTH:
    //  1. a verified email, read from the signed ID token
    //     (request.auth.token.email_verified, set by Firebase Auth), and
    //  2. an acceptance record for the CURRENT Terms version.
    // Keep requiredTermsVersion() equal to TermsService.currentVersion in
    // lib/services/terms_service.dart. Bumping both forces every user to
    // re-accept before they can read or write protected data again.
    // ============================================================
    function requiredTermsVersion() {
      return '1.0';
    }

    function isVerified() {
      return request.auth != null
        && request.auth.token.email_verified == true;
    }

    function hasAcceptedTerms() {
      return exists(
        /databases/$(database)/documents/termsAcceptances/$(
          request.auth.uid + '_' + requiredTermsVersion()
        )
      );
    }

    // Replaces the bare `request.auth != null` check on protected data.
    function hasAccess() {
      return isVerified() && hasAcceptedTerms();
    }

    // ============================================================
    // USERS (moderation state: offenseCount, bannedUntil)
    // Server-managed. A user can read only their own document so the
    // app can show warnings/ban status. Nobody can write from the app.
    // ============================================================

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow write: if false;
    }


    // ============================================================
    // TERMS ACCEPTANCES
    // One record per user per Terms version (id = uid_version).
    // Create-only: a record can never be edited or deleted from the app,
    // so it works as an audit trail of who accepted which version.
    // ============================================================
    match /termsAcceptances/{acceptanceId} {
      allow get: if request.auth != null
        && (
          resource == null
          || resource.data.userId == request.auth.uid
        );
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId', 'email', 'version', 'acceptedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.version == requiredTermsVersion()
        && acceptanceId == request.auth.uid + '_' + request.resource.data.version
        && request.resource.data.email is string
        && request.auth.token.email != null
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.acceptedAt == request.time;
      allow update, delete: if false;
    }

    // ============================================================
    // REPORTS
    // One report per user per post (id = itemId_reporterUid).
    // Status changes (pending -> removed/dismissed) are made only by
    // the moderation Worker.
    // ============================================================

    match /reports/{reportId} {

      allow get: if hasAccess()
        && (
          resource == null
          || resource.data.reporterId == request.auth.uid
        );

      allow list: if hasAccess()
        && resource.data.reporterId == request.auth.uid;

      allow create: if hasAccess()
        && reportId == request.resource.data.itemId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly([
          'itemId', 'reporterId', 'reason', 'details', 'status', 'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reason in [
          'spam', 'inappropriate', 'harassment', 'scam', 'other'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 300
        && request.resource.data.createdAt == request.time
        && exists(
          /databases/$(database)/documents/items/$(request.resource.data.itemId)
        )
        && get(
          /databases/$(database)/documents/items/$(request.resource.data.itemId)
        ).data.ownerId != request.auth.uid;

      allow update, delete: if false;
    }


    // ============================================================
    // ITEMS  (the only place the posting ban applies)
    // ============================================================

    match /items/{itemId} {

      // All authenticated users can see Lost/Found posts.
      allow read: if hasAccess();

      // A user can create only their own post, and not while banned.
      allow create: if hasAccess()
        && !isBanned()
        && request.resource.data.ownerId == request.auth.uid;

      // Only the owner can update their item, and not while banned.
      // Ownership cannot be transferred.
      allow update: if hasAccess()
        && !isBanned()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      // Only the owner can delete their item (allowed even while banned).
      allow delete: if hasAccess()
        && resource.data.ownerId == request.auth.uid;
    }


    // ============================================================
    // CLAIMS  (not affected by the posting ban)
    // ============================================================

    match /claims/{claimId} {

      // Single-document read. Allowed when the doc doesn't exist yet
      // (resource == null), otherwise only claimant or finder.
      allow get: if hasAccess()
        && (
          resource == null
          || resource.data.claimantId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );

      // Queries must filter by claimantId or ownerId == current user.
      allow list: if hasAccess()
        && (
          resource.data.claimantId == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );

      // One claim per item per user (id = itemId_claimantId).
      allow create: if hasAccess()
        && claimId == request.resource.data.itemId + '_' + request.auth.uid
        && request.resource.data.claimantId == request.auth.uid
        && request.resource.data.ownerId != request.auth.uid
        && request.resource.data.status == 'Pending'
        && exists(
          /databases/$(database)/documents/items/$(request.resource.data.itemId)
        )
        && get(
          /databases/$(database)/documents/items/$(request.resource.data.itemId)
        ).data.ownerId == request.resource.data.ownerId
        && get(
          /databases/$(database)/documents/items/$(request.resource.data.itemId)
        ).data.status in ['Found', 'Pending'];

      allow update: if hasAccess()
        && (

          // 1) The finder/owner can change only the claim status.
          (
            resource.data.ownerId == request.auth.uid
            && request.resource.data.claimantId == resource.data.claimantId
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.itemId == resource.data.itemId
            && request.resource.data.itemTitle == resource.data.itemTitle
            && request.resource.data.itemImageUrl == resource.data.itemImageUrl
            && request.resource.data.answer == resource.data.answer
            && request.resource.data.additionalDetails == resource.data.additionalDetails
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status'
            ])
            && request.resource.data.status in [
              'Pending',
              'Approved',
              'Rejected'
            ]
          )

          ||

          // 2) A claimant may re-submit only a previously rejected claim.
          (
            resource.data.claimantId == request.auth.uid
            && resource.data.status == 'Rejected'
            && request.resource.data.claimantId == resource.data.claimantId
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.itemId == resource.data.itemId
            && request.resource.data.itemTitle == resource.data.itemTitle
            && request.resource.data.itemImageUrl == resource.data.itemImageUrl
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.status == 'Pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status',
              'answer',
              'additionalDetails'
            ])
          )
        );

      // Only the finder can delete an approved claim.
      allow delete: if hasAccess()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'Approved';
    }


    // ============================================================
    // COMPLETED RETURNS + FEEDBACK (optional, post-transaction)
    // completedReturns/{claimId}: written by the finder while the claim is
    // Approved (right before it is deleted). Immutable afterwards.
    // feedback/{claimId}_{uid}: one per participant, create-only, so
    // duplicates are impossible. Readable only by its author.
    // ============================================================

    match /completedReturns/{returnId} {
      allow get: if hasAccess()
        && (
          resource == null
          || resource.data.ownerId == request.auth.uid
          || resource.data.claimantId == request.auth.uid
        );
      allow list: if false;

      allow create: if hasAccess()
        && request.resource.data.keys().hasOnly([
          'itemId', 'itemTitle', 'ownerId', 'claimantId', 'completedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && returnId == request.resource.data.itemId + '_' + request.resource.data.claimantId
        && request.resource.data.completedAt == request.time
        && exists(/databases/$(database)/documents/claims/$(returnId))
        && get(/databases/$(database)/documents/claims/$(returnId)).data.status == 'Approved'
        && get(/databases/$(database)/documents/claims/$(returnId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/claims/$(returnId)).data.claimantId == request.resource.data.claimantId;

      allow update, delete: if false;
    }

    match /feedback/{feedbackId} {
      // resource == null lets the app check "already submitted?" before
      // writing (a missing doc would otherwise be denied).
      allow get: if hasAccess()
        && (resource == null || resource.data.authorId == request.auth.uid);
      allow list: if false;

      allow create: if hasAccess()
        && request.resource.data.keys().hasOnly([
          'returnId', 'itemTitle', 'authorId', 'role', 'otherUserId',
          'rating', 'recommendation', 'createdAt'
        ])
        && feedbackId == request.resource.data.returnId + '_' + request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.role in ['finder', 'claimant']
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.recommendation is string
        && request.resource.data.recommendation.size() <= 500
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/completedReturns/$(request.resource.data.returnId))
        && (
          (
            request.resource.data.role == 'finder'
            && get(/databases/$(database)/documents/completedReturns/$(request.resource.data.returnId)).data.ownerId == request.auth.uid
            && get(/databases/$(database)/documents/completedReturns/$(request.resource.data.returnId)).data.claimantId == request.resource.data.otherUserId
          )
          ||
          (
            request.resource.data.role == 'claimant'
            && get(/databases/$(database)/documents/completedReturns/$(request.resource.data.returnId)).data.claimantId == request.auth.uid
            && get(/databases/$(database)/documents/completedReturns/$(request.resource.data.returnId)).data.ownerId == request.resource.data.otherUserId
          )
        );

      allow update, delete: if false;
    }


    // ============================================================
    // NOTIFICATIONS
    // ============================================================

    match /notifications/{notificationId} {

      allow read: if hasAccess()
        && resource.data.recipientId == request.auth.uid;

      // Users can only mark their own notifications as read.
      allow update: if hasAccess()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead'
        ]);

      // Clients may create only the app's normal notification types.
      // Warning/ban notices (moderation_*) can be created only by the
      // moderation Worker, so they cannot be faked.
      allow create: if hasAccess()
        && request.resource.data.type in [
          'match',
          'category_match',
          'claim_received',
          'claim_approved',
          'claim_rejected',
          'claim_update',
          'message'
        ];

      allow delete: if hasAccess()
        && resource.data.recipientId == request.auth.uid;
    }


    // ============================================================
    // CONVERSATIONS  (not affected by the posting ban)
    // ============================================================

    match /conversations/{conversationId} {

      // Single-document read. Allowed when the doc doesn't exist yet,
      // otherwise only participants (supports legacy `participants`).
      allow get: if hasAccess()
        && (
          resource == null
          || (
            resource.data.participantIds is list
            && request.auth.uid in resource.data.participantIds
          )
          || (
            resource.data.participants is list
            && request.auth.uid in resource.data.participants
          )
        );

      // Queries (where participantIds arrayContains uid).
      allow list: if hasAccess()
        && request.auth.uid in resource.data.participantIds;

      // A new conversation must contain exactly two participants.
      allow create: if hasAccess()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds[0]
            != request.resource.data.participantIds[1];

      // Participants can update conversation metadata only.
      allow update: if hasAccess()
        && resource.data.participantIds is list
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.participantIds
            == resource.data.participantIds
        && request.resource.data.postId
            == resource.data.postId
        && request.resource.data.itemName
            == resource.data.itemName
        && request.resource.data.itemImageUrl
            == resource.data.itemImageUrl
        && request.resource.data.itemType
            == resource.data.itemType
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageTime',
          'unreadCounts'
        ]);

      // Participants can delete their conversation.
      allow delete: if hasAccess()
        && resource.data.participantIds is list
        && request.auth.uid in resource.data.participantIds;


      // ============================================================
      // MESSAGES
      // ============================================================

      match /messages/{messageId} {

        allow read: if hasAccess()
          && (
            (
              get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.participantIds is list
              &&
              request.auth.uid in get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.participantIds
            )
            ||
            (
              get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.participants is list
              &&
              request.auth.uid in get(
                /databases/$(database)/documents/conversations/$(conversationId)
              ).data.participants
            )
          );

        allow create: if hasAccess()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.isRead == false;

        allow update: if hasAccess()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds
          && resource.data.senderId != request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.senderName == resource.data.senderName
          && request.resource.data.text == resource.data.text
          && request.resource.data.timestamp == resource.data.timestamp
          && resource.data.isRead == false
          && request.resource.data.isRead == true;

        allow delete: if hasAccess()
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.participantIds;
      }
    }


    // ============================================================
    // EVERYTHING ELSE (includes the server-only moderationLog)
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}